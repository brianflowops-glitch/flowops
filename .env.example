# Copy to .env.local (or .env.development.local) for local dev. Never commit real values.

# ── Required ─────────────────────────────────────────────────────────────
# Postgres (Neon on Vercel — injected automatically by the Neon integration)
DATABASE_URL=
# Neon direct (non-pooler) URL; used only for billing add-on locks (docs/BILLING.md §11). Optional for a local DB.
DATABASE_URL_UNPOOLED=
# Better Auth: random 32+ byte secret (`openssl rand -base64 32`). Also derives
# the keys that encrypt Google tokens and sign FlowAI tool approvals.
BETTER_AUTH_SECRET=
# Public base URL, e.g. https://flowopsagent.ai (http://localhost:3000 locally)
BETTER_AUTH_URL=

# ── Ownership ────────────────────────────────────────────────────────────
# Comma-separated emails allowed to claim the demo org "flowops-demo" as Owner
# on first sign-up. Unset = the very first sign-up becomes Owner.
FLOWOPS_OWNER_EMAILS=

# ── Email verification ───────────────────────────────────────────────────
# "true" blocks sign-in until the email is verified. Default off. Only takes
# effect once RESEND_API_KEY is set, so nobody is locked out while email is simulated.
REQUIRE_EMAIL_VERIFICATION=

# ── FlowAI (Vercel AI Gateway) ───────────────────────────────────────────
# On Vercel, OIDC is automatic. Locally: `vercel env pull` (VERCEL_OIDC_TOKEN)
# or set a key here.
AI_GATEWAY_API_KEY=
# Optional model override (default: openai/gpt-4.1-mini)
AI_GATEWAY_MODEL=

# ── Optional integrations — each stays SIMULATED until its vars are set ──
# Google Calendar (OAuth web client; redirect URI:
#   <BETTER_AUTH_URL>/api/integrations/google/callback). Then Owner clicks
#   Administration → Integrations → Connect Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend email
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "FlowOps <bookings@flowopsagent.ai>"
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Twilio SMS (FROM_NUMBER or MESSAGING_SERVICE_SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ── Reliability (v2.4, all optional) ──
# Ops alerts for final notification failures / limiter DB errors: webhook (Slack-compatible JSON `text`) and/or email via Resend.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
# Inbound webhooks: Resend signing secret (whsec_…); Twilio uses TWILIO_AUTH_TOKEN.
RESEND_WEBHOOK_SECRET=
# e.g. https://flowopsagent.ai/api/webhooks/twilio/status — added to every outbound SMS.
TWILIO_STATUS_CALLBACK_URL=
# Public origin Twilio signs against, if the request host differs (e.g. https://flowopsagent.ai).
TWILIO_WEBHOOK_BASE_URL=
# true = reply to STOP/START/HELP from FlowOps (leave unset if Twilio Advanced Opt-Out replies).
TWILIO_KEYWORD_REPLIES=
# Vercel Cron bearer secret for /api/cron/notifications and /api/cron/addon-charges (unset → those crons return 503).
CRON_SECRET=

# ── Billing (Stripe) — names only; see docs/BILLING.md §8. Everything is off unless BILLING_ENABLED=true ──
# "true" turns billing on (routes, lock). Set BILLING_EXEMPT_ORG_IDS first. is_demo orgs are never locked.
BILLING_ENABLED=
# Comma-separated org ids never locked, e.g. org_flowops_demo,org_pilot_1
BILLING_EXEMPT_ORG_IDS=
# sk_test_… locally; an sk_live_/rk_live_ key is refused unless STRIPE_ALLOW_LIVE=true
STRIPE_SECRET_KEY=
STRIPE_ALLOW_LIVE=
# whsec_… of the endpoint <origin>/api/billing/webhook (differs per environment)
STRIPE_WEBHOOK_SECRET=
# Plan prices (price_…): monthly, and _ANNUAL yearly
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_ANNUAL=
# Add-on prices: recurring monthly + _ANNUAL; TEXTS_1000 is a one-time price
STRIPE_ADDON_PRICE_SEAT=
STRIPE_ADDON_PRICE_SEAT_ANNUAL=
STRIPE_ADDON_PRICE_LOCATION=
STRIPE_ADDON_PRICE_LOCATION_ANNUAL=
STRIPE_ADDON_PRICE_BRANDING=
STRIPE_ADDON_PRICE_BRANDING_ANNUAL=
STRIPE_ADDON_PRICE_TEXTS_1000=
# Optional: legacy recurring texts price, per-add-on max (STRIPE_ADDON_MAX_<KEY>), plan limit overrides (PLAN_LIMITS_<PLAN>)
STRIPE_ADDON_LEGACY_PRICE_TEXTS_1000=
# Optional: free-trial days (default 14, 0 disables)
TRIAL_DAYS=
# Email-only appointment reminders (off unless exactly "true"; also needs RESEND_API_KEY and a working /api/cron/notifications cron).
EMAIL_REMINDERS_ENABLED=
# Optional: send when the appointment is within this many hours (default 24, 1–72). Use 30 for a once-a-day cron.
EMAIL_REMINDER_LEAD_HOURS=
# Optional: don't send when it starts sooner than this many minutes (default 30).
EMAIL_REMINDER_MIN_LEAD_MINUTES=

# ── Payments at booking (Stripe Connect) — see docs/PAYMENTS.md. Off unless exactly "true" (ships dark) ──
# Uses STRIPE_SECRET_KEY above (same platform account; Connect must be enabled on it).
BOOKING_PAYMENTS_ENABLED=
# whsec_… of the Connect endpoint <origin>/api/webhooks/stripe-connect ("Events on Connected accounts")
STRIPE_CONNECT_WEBHOOK_SECRET=
