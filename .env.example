# Optional — FlowOps runs fine with no environment variables.
# FlowAI Assistant uses Vercel AI Gateway. On Vercel, OIDC is automatic.
# Locally: `vercel env pull` (VERCEL_OIDC_TOKEN), or set an AI Gateway key:
AI_GATEWAY_API_KEY=
# Optional model override (default: openai/gpt-4.1-mini)
AI_GATEWAY_MODEL=
