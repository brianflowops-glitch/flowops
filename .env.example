# Copy to .env.local (or .env.development.local) for local dev. Never commit real values.

# ── Required ─────────────────────────────────────────────────────────────
# Postgres (Neon on Vercel — injected automatically by the Neon integration)
DATABASE_URL=
# Neon direct (non-pooler) URL; used only for billing add-on locks (docs/BILLING.md §11). Optional for a local DB.
DATABASE_URL_UNPOOLED=
# Better Auth: random 32+ byte secret (`openssl rand -base64 32`). Also derives
# the keys that encrypt Google tokens and sign FlowAI tool approvals.
BETTER_AUTH_SECRET=
# Public base URL, e.g. https://flowopsagent.ai (http://localhost:3000 locally)
BETTER_AUTH_URL=

# ── Ownership ────────────────────────────────────────────────────────────
# Comma-separated emails allowed to claim the demo org "flowops-demo" as Owner
# on first sign-up. Unset = the very first sign-up becomes Owner.
FLOWOPS_OWNER_EMAILS=

# ── Email verification ───────────────────────────────────────────────────
# "true" blocks sign-in until the email is verified. Default off. Only takes
# effect once RESEND_API_KEY is set, so nobody is locked out while email is simulated.
REQUIRE_EMAIL_VERIFICATION=

# ── FlowAI (Vercel AI Gateway) ───────────────────────────────────────────
# On Vercel, OIDC is automatic. Locally: `vercel env pull` (VERCEL_OIDC_TOKEN)
# or set a key here.
AI_GATEWAY_API_KEY=
# Optional model override (default: openai/gpt-4.1-mini)
AI_GATEWAY_MODEL=

# ── Optional integrations — each stays SIMULATED until its vars are set ──
# Google Calendar (OAuth web client; redirect URI:
#   <BETTER_AUTH_URL>/api/integrations/google/callback). Then Owner clicks
#   Administration → Integrations → Connect Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend email
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "FlowOps <bookings@flowopsagent.ai>"
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Twilio SMS (FROM_NUMBER or MESSAGING_SERVICE_SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ── Reliability (v2.4, all optional) ──
# Ops alerts for final notification failures / limiter DB errors: webhook (Slack-compatible JSON `text`) and/or email via Resend.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
# Inbound webhooks: Resend signing secret (whsec_…); Twilio uses TWILIO_AUTH_TOKEN.
RESEND_WEBHOOK_SECRET=
# e.g. https://flowopsagent.ai/api/webhooks/twilio/status — added to every outbound SMS.
TWILIO_STATUS_CALLBACK_URL=
# Public origin Twilio signs against, if the request host differs (e.g. https://flowopsagent.ai).
TWILIO_WEBHOOK_BASE_URL=
# true = reply to STOP/START/HELP from FlowOps (leave unset if Twilio Advanced Opt-Out replies).
TWILIO_KEYWORD_REPLIES=
# Vercel Cron bearer secret for /api/cron/notifications (recovery of stuck "queued" notifications).
CRON_SECRET=
